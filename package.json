{
  "name": "datspace",
  "productName": "Datspace",
  "version": "0.1.0",
  "description": "Desktop analytics workspace powered by DuckDB and Apache Arrow",
  "main": ".vite/build/main-entry.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "build:e2e": "node scripts/build-e2e.mjs",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "arch": "depcruise src --config .dependency-cruiser.mjs",
    "dead-code": "knip",
    "test:mutation": "stryker run",
    "check": "npm run typecheck && npm run lint",
    "check:all": "npm run typecheck && npm run lint && npm run test:coverage && npm run arch && npm run dead-code",
    "audit": "npm audit --audit-level=moderate",
    "prepare": "husky"
  },
  "keywords": [
    "analytics",
    "duckdb",
    "arrow",
    "electron"
  ],
  "author": {
    "name": "Jared McFarland",
    "email": "jaredcolin@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@duckdb/node-api": "1.4.4-r.1",
    "@uwdata/flechette": "^2.3.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.52.0",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.3.7",
    "electron": "^33.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["biome check --write --no-errors-on-unmatched"],
    "*.{json,md,yaml,yml}": ["biome format --write --no-errors-on-unmatched"]
  }
}
